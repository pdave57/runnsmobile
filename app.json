{
  "expo": {
    "name": "Runns Mobile",
    "slug": "runnsmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "runnsmobile",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runns.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Runns Mobile to use your location to track deliveries",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Runns Mobile to use your location to track deliveries"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.runns.mobile",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD0RGSO5reCxoNzGmcVX7tYEnfOmB9JtRw"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow Runns Mobile to use your location to track deliveries"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Runns Mobile to use your location to track deliveries",
          "locationWhenInUsePermission": "Allow Runns Mobile to use your location to track deliveries"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false,
      "newArchEnabled": true
    }
  }
}